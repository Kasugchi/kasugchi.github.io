  "tesoros": {
    "A": {
      "texto": "Sobre el altar, envuelto en un paño gris, reposa el Sello de Hueso.",
      "flag": "selloHueso"
    },
    "C": {
      "texto": "En el sarcófago abierto, entre cenizas aún tibias, encontráis el Sello de Ceniza.",
      "flag": "selloCeniza"
    },
    "I": {
      "texto": "El altar está manchado de rojo. En su centro brilla el Sello de Sangre.",
      "flag": "selloSangre"
    },
    "B": {
      "texto": "En la mesa de los orcos, 80 monedas a medio repartir.",
      "oro": 80
    },
    "O": {
      "texto": "Entre las tumbas, ofrendas olvidadas: 120 monedas y una vieja trompeta de hueso, la Trompeta Ancestral.",
      "oro": 120,
      "reliquia": "trompeta"
    },
    "J": {
      "texto": "Detrás de los libros, un frasco curativo.",
      "objeto": "pocionCurar"
    },
    "K": {
      "texto": "Colgada de la pared, una ballesta con su carcaj.",
      "arma": "ballesta"
    }
  },
