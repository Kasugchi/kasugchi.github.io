  "tesoros": {
    "A": {
      "texto": "En un estante, detrás de un cráneo, un elixir gris.",
      "objeto": "pocionPiedra"
    },
    "C": {
      "texto": "Entre los libros hay una nota y 30 monedas: «El grimorio duerme al este de la cripta, tras un muro hueco del corredor». Junto a la nota, atado con un cordel, un legajo de Escritos Antiguos.",
      "oro": 30,
      "reliquia": "escritos"
    },
    "D": {
      "texto": "Dentro del sarcófago, entre vendas podridas, 120 monedas.",
      "oro": 120
    },
    "F": {
      "texto": "Colgado del potro, un frasco curativo intacto.",
      "objeto": "pocionCurar"
    },
    "H": {
      "texto": "En el armero hay una bolsa con 100 monedas.",
      "oro": 100
    },
    "E": {
      "texto": "Sobre la mesa del alquimista descansa el Grimorio de Ceniza, junto a 50 monedas. Al cogerlo, la estatua del rincón abre los ojos.",
      "oro": 50,
      "flag": "grimorio"
    }
  },
